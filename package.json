{
  "name": "@hackclub-community/atproto-pds",
  "version": "1.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dotenvx:run": "dotenvx run -f .env.production --",
    "dotenvx:set": "dotenvx set -f .env.production --",
    "gen-keys:jwt": "pnpm run gen-keys:secure-secret",
    "gen-keys:secure-secret": "openssl rand --hex 16",
    "gen-keys:plc": "openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32" 
  },
  "keywords": [],
  "author": "",
  "license": "MIT AND APACHE-2.0",
  "packageManager": "pnpm@10.18.2",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0"
  }
}
